# Validate the selected user domain before anything is bound or restarted, so
# the UI shows the error next to the field. An omitted "ldap_domain" keeps the
# current domain (restore and clone do not send it); "" clears it.

import json
import sys

import agent
from metabase_ldap import LdapError, validate

agent.set_weight(__file__.rsplit("/", 1)[-1], 0)  # validation step, no task progress

request = json.load(sys.stdin)
if "ldap_domain" not in request:
    sys.exit(0)

try:
    validate(request["ldap_domain"].strip())
except LdapError as error:
    agent.set_status("validation-failed")
    json.dump([{"field": "ldap_domain", "parameter": "ldap_domain",
                "value": request["ldap_domain"], "error": error.key}], fp=sys.stdout)
    sys.exit(3)
